<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard | StudentWallet</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

  <header>
    <nav class="navbar">
      <a href="/" class="logo">
        <img
          src="/images/studentwallet-logo.png"
          alt="StudentWallet Logo"
          class="brand-logo"
        >
      </a>

      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/expenses">Dashboard</a></li>
        <li><a href="/expenses/new">Add Expense</a></li>
      </ul>
    </nav>
  </header>

  <main class="expenses-page">

    <div class="expenses-header">
      <div>
        <h1>Expense Dashboard</h1>
        <p>View and manage your student expenses.</p>
      </div>

      <a href="/expenses/new" class="expense-add-btn">
        + Add Expense
      </a>
    </div>

    <%
      const totalSpending = expenses.reduce(
        (total, expense) => total + Number(expense.amount),
        0
      );

      const totalExpenses = expenses.length;

      const highestExpense = expenses.length > 0
        ? Math.max(...expenses.map(e => Number(e.amount)))
        : 0;
    %>

    <section class="dashboard-stats">

      <div class="stat-card">
        <h3>Total Spending</h3>
        <p>$<%= totalSpending.toFixed(2) %></p>
      </div>

      <div class="stat-card">
        <h3>Total Expenses</h3>
        <p><%= totalExpenses %></p>
      </div>

      <div class="stat-card">
        <h3>Highest Expense</h3>
        <p>$<%= highestExpense.toFixed(2) %></p>
      </div>

    </section>

    <section class="expenses-card">
      <h2>Expense History</h2>

      <% if (expenses.length === 0) { %>

        <div class="expenses-empty">
          <h3>No expenses recorded yet.</h3>
          <p>Start tracking your spending today!</p>
          <a href="/expenses/new">Add Your First Expense</a>
        </div>

      <% } else { %>

        <div class="expenses-table-wrap">
          <table class="expenses-table">

            <thead>
              <tr>
                <th>Expense Name</th>
                <th>Amount</th>
                <th>Category</th>
                <th>Date</th>
                <th>Description</th>
              </tr>
            </thead>

            <tbody>
              <% expenses.forEach(function(expense) { %>
                <tr>
                  <td><%= expense.name %></td>

                  <td>
                    $<%= Number(expense.amount).toFixed(2) %>
                  </td>

                  <td>
                    <span class="category-badge">
                      <%= expense.category %>
                    </span>
                  </td>

                  <td>
                    <%= new Date(expense.date).toLocaleDateString(
                      'en-CA',
                      { timeZone: 'UTC' }
                    ) %>
                  </td>

                  <td>
                    <%= expense.description || '-' %>
                  </td>
                </tr>
              <% }); %>
            </tbody>

          </table>
        </div>

      <% } %>
    </section>

  </main>

  <footer>
    <p>&copy; 2026 StudentWallet | INFR3120 Project</p>
  </footer>

</body>
</html>