
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Add Expense | StudentWallet</title>

  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

  <!-- Navigation -->
  <header>
    <nav class="navbar">

      <a href="/" class="logo">
        <img
          src="/images/studentwallet-logo.png"
          alt="StudentWallet Logo"
          class="brand-logo"
        >
      </a>

      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/expenses">Dashboard</a></li>
        <li><a href="/expenses/new">Add Expense</a></li>
      </ul>

    </nav>
  </header>

  <!-- Add Expense Form -->
  <main class="form-page">

    <div class="form-container">

      <div class="form-header">
        <h1>Add New Expense</h1>

        <p>
          Record your daily spending to stay
          organized and manage your money.
        </p>
      </div>

      <form
        id="expenseForm"
        action="/expenses"
        method="POST"
      >

        <!-- Expense Name -->
        <div class="form-group">
          <label for="name">Expense Name</label>

          <input
            type="text"
            id="name"
            name="name"
            placeholder="e.g. Groceries"
            maxlength="100"
            required
          >
        </div>

        <!-- Amount -->
        <div class="form-group">
          <label for="amount">Amount ($)</label>

          <input
            type="number"
            id="amount"
            name="amount"
            placeholder="e.g. 25.50"
            min="0.01"
            step="0.01"
            required
          >
        </div>

        <!-- Category -->
        <div class="form-group">
          <label for="category">Category</label>

          <select
            id="category"
            name="category"
            required
          >
            <option value="">Select a category</option>
            <option value="Food">Food</option>
            <option value="Transportation">Transportation</option>
            <option value="School Supplies">School Supplies</option>
            <option value="Entertainment">Entertainment</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <!-- Date -->
        <div class="form-group">
          <label for="date">Date</label>

          <input
            type="date"
            id="date"
            name="date"
            required
          >
        </div>

        <!-- Description -->
        <div class="form-group">
          <label for="description">
            Description (Optional)
          </label>

          <textarea
            id="description"
            name="description"
            rows="4"
            maxlength="500"
            placeholder="Enter additional details..."
          ></textarea>
        </div>

        <p id="formError" class="form-error" role="alert"></p>

        <!-- Buttons -->
        <div class="form-buttons">

          <button type="submit" class="btn btn-primary">
            Save Expense
          </button>

          <a href="/" class="btn btn-secondary">
            Cancel
          </a>

        </div>

      </form>

    </div>

  </main>

  <!-- Footer -->
  <footer>
    <p>&copy; 2026 StudentWallet | INFR3120 Project</p>
  </footer>

  <script src="/javascripts/expense-form.js"></script>

</body>
</html>
